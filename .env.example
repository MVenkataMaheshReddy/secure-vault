# ====================================================================
# SecureVault - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in environment-specific secrets.
# NEVER commit production passwords, keys, or secrets to source control.
# ====================================================================

# ----------------- Database Configuration -----------------
DB_URL=jdbc:mysql://localhost:3306/document_management?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=Ashokm@2005

# ----------------- JWT Authentication (>= 256 bits) -----------------
# Generate a cryptographically secure 256-bit (32+ byte) Base64 secret key
# e.g., openssl rand -base64 32
JWT_SECRET=nY1mDkHg2JX3aXK0xkj93i9m1p7CqJUt8V2lDmj3Lk9B+oVyR3cJ5z4E3t3UOa0x
# JWT validity window in milliseconds (default: 3600000 = 1 hour)
JWT_EXPIRATION=3600000

# ----------------- CORS Security -----------------
# Comma-separated list of allowed origins (no trailing slashes, strict origin check)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ----------------- Initial Seed Admin Account -----------------
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@securevault.com
ADMIN_PASSWORD=ChangeThisPasswordInProd!123

# ----------------- Storage & File Uploads -----------------
UPLOAD_DIR=storage/documents
MAX_DOC_SIZE=10485760
MAX_IMAGE_SIZE=5242880

# ----------------- QR Code & Verification -----------------
FRONTEND_BASE_URL=http://localhost:3000
QR_DIR=storage/qr
VERIFY_RATE_LIMIT_PER_MIN=30

# ----------------- Brute-Force & Rate Limiting -----------------
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ----------------- Tesseract OCR Engine -----------------
TESSDATA_PREFIX=storage/tessdata
OCR_LANGUAGE=eng
OCR_ENABLED=true
